# Copy to .env and fill in what you need. Everything here is optional — the
# backend runs fine with none of it set.

# Enables the HyDE step (an LLM describes the ideal next node before the
# semantic search step runs). Leave all three unset to use the deterministic
# fallback. If more than one is set, ANTHROPIC_API_KEY wins, then
# GEMINI_API_KEY, then OLLAMA_URL.
ANTHROPIC_API_KEY=

# Free tier via https://aistudio.google.com/apikey — no local install needed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Alternative to the above: point at a local Ollama instance instead.
OLLAMA_URL=
OLLAMA_MODEL=llama3.2

# Comma-separated list of allowed origins for CORS. Defaults to "*" since the
# extension can be running against n8n cloud, self-hosted, or localhost.
CORS_ORIGINS=

LOG_LEVEL=INFO

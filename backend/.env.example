# Copy to .env and fill in what you need. Everything here is optional — the
# backend runs fine with none of it set.

# Enables the HyDE step (an LLM describes the ideal next node before the
# semantic search step runs). Leave unset to use the deterministic fallback.
ANTHROPIC_API_KEY=

# Alternative to ANTHROPIC_API_KEY: point at a local Ollama instance instead.
OLLAMA_URL=
OLLAMA_MODEL=llama3.2

# Comma-separated list of allowed origins for CORS. Defaults to "*" since the
# extension can be running against n8n cloud, self-hosted, or localhost.
CORS_ORIGINS=

LOG_LEVEL=INFO
